# Copy to .env.local and fill in. Never commit real values.

# Supabase (cloud project). For local dev with `pnpm db:start`, use the URL/key printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used for auth redirects and email links (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (configured in the Supabase Auth provider settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (newsletter + transactional email)
RESEND_API_KEY=
NEXT_PUBLIC_FROM_EMAIL=

# Dev only: role preview switcher for /campus (ignored in production).
# Signs in with these test accounts — point them at a local/staging Supabase, not production.
CAMPUS_PREVIEW_AUTH=
PREVIEW_STUDENT_EMAIL=
PREVIEW_INSTRUCTOR_EMAIL=
PREVIEW_ADMIN_EMAIL=
PREVIEW_PASSWORD=
